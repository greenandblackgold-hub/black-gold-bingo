# Local development only. Copy to .env and replace both secrets.
NODE_ENV=development
PORT=8080
STORAGE=memory
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SMS_WEBHOOK_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_PHONE=0900000001
ADMIN_PIN=654321
REGISTRATION_ENABLED=true
